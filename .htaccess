# Configuration Apache pour l'hébergement OVH.
#
# À déposer dans le dossier "www/", à côté de index.html.

# ---------- Forcer HTTPS ----------
#
# Apache ne redirige pas vers HTTPS de lui-même. Sans cette règle, un
# visiteur qui tape "lawave.fr" sans préciser le protocole reste en
# clair sur le port 80.
#
# Deux conditions plutôt qu'une : sur un hébergement mutualisé, la
# requête arrive souvent à Apache déjà déchiffrée par un frontal, et
# %{HTTPS} vaut alors "off" même quand le visiteur est bien en HTTPS.
# L'en-tête X-Forwarded-Proto tranche ce cas. Rediriger sur la seule
# valeur de %{HTTPS} provoquerait une boucle.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteCond %{HTTPS} !=on
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]
</IfModule>

# ---------- Page d'accueil ----------
DirectoryIndex index.html

# ---------- Pages d'erreur ----------
#
# Le site est une page unique à routage par ancre (#catalogue, #communaute...) : ces adresses ne passent jamais
# par une erreur. Une adresse de chemin inconnue (lawave.fr/nimportequoi) reçoit en revanche une vraie page 404,
# avec le bon code HTTP, au lieu de la page d'accueil déguisée.
ErrorDocument 404 /404.html

# ---------- Compression ----------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml application/xml application/json application/javascript text/javascript image/svg+xml application/manifest+json
</IfModule>

# ---------- Cache navigateur ----------
#
# Les scripts du site portent une empreinte (?v=...) posée à chaque mise en ligne : ils peuvent se garder longtemps.
# index.html, lui, se revérifie toujours : c'est lui qui désigne les bonnes empreintes.
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType application/javascript "access plus 30 days"
  ExpiresByType text/javascript "access plus 30 days"
  ExpiresByType image/png "access plus 30 days"
  ExpiresByType image/jpeg "access plus 30 days"
  ExpiresByType image/webp "access plus 30 days"
  ExpiresByType image/svg+xml "access plus 30 days"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType application/manifest+json "access plus 1 day"
  ExpiresByType text/plain "access plus 1 day"
  ExpiresByType application/xml "access plus 1 day"
  ExpiresByType text/xml "access plus 1 day"
</IfModule>
AddType application/manifest+json .webmanifest
AddType font/woff2 .woff2

# ---------- En-têtes de sécurité ----------
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Content-Security-Policy "frame-ancestors 'self'"
  Header always set Strict-Transport-Security "max-age=15552000"
</IfModule>
